# ========================================================
# BentoPDF Tauri Desktop Builder for Linux (.deb / .AppImage)
# ========================================================

# --- Stage 1: Build Frontend Assets ---
FROM node:26-bookworm-slim AS frontend-builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY vendor ./vendor
ENV HUSKY=0

RUN npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 60000 && \
    npm config set fetch-retry-maxtimeout 300000 && \
    npm config set fetch-timeout 600000 && \
    npm ci

COPY . .

ENV NODE_OPTIONS="--max-old-space-size=3072"
RUN npm run build:desktop

# --- Stage 2: Build Tauri Rust Native App ---
FROM rust:1-bookworm AS tauri-builder
WORKDIR /app

# Install system dependencies required by Tauri v2 and WebKitGTK
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    build-essential \
    curl \
    wget \
    file \
    libxdo-dev \
    libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libfuse2 \
    patchelf \
    squashfs-tools \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy Node & npm runtime from Stage 1 for hook scripts
COPY --from=frontend-builder /usr/local/bin /usr/local/bin
COPY --from=frontend-builder /usr/local/lib/node_modules /usr/local/lib/node_modules

# Fast install Tauri CLI via cargo-binstall binary
RUN curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash && \
    cargo binstall -y --force tauri-cli@^2.0

# Copy compiled frontend assets from Stage 1
COPY --from=frontend-builder /app/dist ./dist

# Copy Tauri backend configuration and Rust code
COPY src-tauri ./src-tauri

# Targets to bundle: deb, appimage (or deb if AppImage FUSE isn't desired)
ARG TAURI_BUNDLES="deb,appimage"
ENV NO_STRIP=true

# Compile release binary and packages (bypass re-running beforeBuildCommand since dist is already ready)
RUN cargo tauri build --bundles ${TAURI_BUNDLES} -c '{"build":{"beforeBuildCommand":""}}'

# Store artifacts internally and copy to mounted /output at container start
RUN mkdir -p /artifacts && cp -rv /app/src-tauri/target/release/bundle/* /artifacts/

CMD ["sh", "-c", "mkdir -p /output && cp -rv /artifacts/* /output/ && echo 'Build complete. Artifacts copied to /output:' && ls -lh /output/"]

# --- Stage 3: Direct BuildKit Export Target ---
# Usage: DOCKER_BUILDKIT=1 docker build -f Dockerfile.tauri --target export --output type=local,dest=./dist-desktop .
FROM scratch AS export
COPY --from=tauri-builder /artifacts/ /
